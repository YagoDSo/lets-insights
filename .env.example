# ─────────────────────────────────────────────────────────────
# Let's Insights — variáveis de ambiente
# Copie para .env (local) e configure como Secrets no GitHub (CI).
# NUNCA commitar o .env preenchido.
# ─────────────────────────────────────────────────────────────

# Claude API (curadoria + redação). CLAUDE_MODEL é opcional: o padrão,
# versionado em lib/config.js, é claude-sonnet-5-5 com raciocínio desligado.
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=

# Gemini API (geração de imagem fallback quando artigo não tem imagem — ver lib/imagegen.js)
GEMINI_API_KEY=

# Banco de dados (SQLite commitado no repo — ver lib/db.js). Caminho opcional,
# padrão é data/newsletter.db.
SQLITE_DB_PATH=

# Envio (hoje Gmail preview — substituível depois por E-goi via lib/sender.js)
SENDER=gmail
GMAIL_USER=yagod@lets.com.br
GMAIL_APP_PASSWORD=
PREVIEW_TO=yagod@lets.com.br

# E-goi (leitura de relatórios + criação de rascunhos "POR PUBLICAR" — ver
# lib/egoi-reports.js e lib/egoi-campaign.js. Precisa também estar nos
# Secrets do GitHub Actions pro WF-03 criar os rascunhos no disparo real)
EGOI_API_KEY=
EGOI_SENDER_ID=2
EGOI_LIST_GESTORES=67
EGOI_LIST_CONDUTORES=34
EGOI_LIST_BASE_LETS=69
# Interruptor do agendamento automático no E-goi (decisão de 22/10/2026).
# Só agenda com o valor exato "ligado". No GitHub é uma VARIÁVEL do
# repositório (não secret). Deixe vazio para só criar rascunhos.
EGOI_AGENDAMENTO=

# ClickUp (tabela de números na task 86ahderm5, ver lib/clickup.js e
# report-clickup.js). Relatório fora de uso desde 14/10/2026: só roda manual.
CLICKUP_API_TOKEN=
CLICKUP_TASK_ID=86ahderm5
